# Leave these empty to run in local demo mode (data stored in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to true only after deploying the AI edge functions (docs/AI_FEATURES.md).
VITE_ENABLE_AI=false

# Set to true only after setting up Gmail sync (docs/EMAIL_SYNC.md).
VITE_ENABLE_EMAIL_SYNC=false

# Production builds without the Supabase settings show a setup error.
# Set to true only to deploy a public demo that stores data in the browser.
VITE_ALLOW_DEMO=false
